# Twitch OAuth token for ad-free streaming (Twitch Turbo / subscriber)
# Get it from: twitch.tv → DevTools → Application → Cookies → auth-token
TWITCH_OAUTH_TOKEN=

# Custom paths for recordings and exports (defaults to ./recordings and ./exports)
# RECORDINGS_DIR=E:\OmniCut\recordings
# EXPORTS_DIR=E:\OmniCut\exports
