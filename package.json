		"svelte": "^5.49.2",
		"svelte-adapter-bun": "^0.5.0",
		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.26.0",
		"hls.js": "^1.6.15"
	}
